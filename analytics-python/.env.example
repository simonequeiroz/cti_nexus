# Variáveis do serviço Python (copie para .env e preencha). O .env não vai para o GitHub.

# Banco: a Connection string do Neon, do jeito que o site mostra (Connect, sem Connection pooling).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require

# Chave combinada com o Java: precisa ser IGUAL ao ETL_CHAVE do backend-java/.env.
ETL_CHAVE=

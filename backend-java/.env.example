# Variáveis de ambiente que o back-end precisa (slide 23). Este arquivo é só o MODELO: vai para o GitHub sem valores reais.
# O Spring não lê .env sozinho: no PowerShell, defina cada uma antes de rodar, ex.: $env:DB_SENHA = "minhaSenha"

# Endereço do banco. No Neon: jdbc:postgresql://<host>.neon.tech/<banco>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/cti_nexus
DB_USUARIO=postgres
DB_SENHA=

# Chave que assina os tokens JWT (32 bytes em Base64). Como gerar: slide 26 ou README do backend-java.
JWT_SECRET_BASE64=

# Primeiro administrador, criado sozinho se o banco não tiver nenhum (padrão: admin@ctinexus.com / 123456).
ADMIN_EMAIL=admin@ctinexus.com
ADMIN_SENHA=

# Endereços do front que podem chamar a API, separados por vírgula.
CORS_ORIGENS=http://localhost:5173
